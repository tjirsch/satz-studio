#!/usr/bin/env bash
# Names gate — refuses a commit that carries a non-example identifier — and the wording
# check — one word for one thing, as satz's glossary has it.
# Enable once per clone:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-names.sh" --staged || exit 1
exec "$root/scripts/check-wording.sh" --staged
