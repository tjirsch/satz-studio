// A team group with its first member already in it.
//
//   use "presets/team-access.satz"

pack team_access version "0.1"

google_cloud_identity_group {
  team {
    display_name = "Team"
    parent = "customers/C0example"
    group_key { id = "team@example.com" }
    labels = { "cloudidentity.googleapis.com/groups.discussion_forum" = "" }
  }
}

google_cloud_identity_group_membership {
  first {
    group = "groups/team"
    preferred_member_key { id = "first.admin@example.com" }
    roles { name = "MEMBER" }
  }
}
