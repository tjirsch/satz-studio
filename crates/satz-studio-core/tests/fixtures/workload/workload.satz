// A workload estate over satz's corpus interface `payments`: its roles are the
// organization's to grant, so satz lists what its resource types need rather than
// checking them (satz's ADR 0101).

estate workload

params {
  customer_organization_id = "123456789012"
  customer_id              = "C0example"
  customer_domain          = "example.com"
  customer_shortname       = "acme"
  default_region           = "europe-west3"
  svc_iac_account          = "svc-iac"
  infra_project_name       = "acme-infra-001"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

use "interface.satz"

providers {
  google {
    alias                 = "google"
    project               = infra_project_name
    region                = default_region
    user_project_override = true
    billing_project       = infra_project_name
  }
}

google_folder {
  team {
    display_name = "Payments team"
    parent       = "${{interface.infra_folder}}"
  }
}

google_service_account {
  app {
    account_id   = "payments-app"
    display_name = "Payments application"
    project      = "${{interface.payments_project}}"
  }
}

google_storage_bucket {
  data {
    name     = "acme-payments-data"
    project  = "${{interface.payments_project}}"
    location = default_region
  }
}

google_pubsub_topic {
  events {
    name    = "payments-events"
    project = "${{interface.payments_project}}"
  }
}

google_project_iam_member {
  app_objects {
    project = "${{interface.payments_project}}"
    role    = "roles/storage.objectAdmin"
    member  = "serviceAccount:payments-app@corp-payments-001.iam.gserviceaccount.com"
  }
}
